{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.14.0",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "node": "22.14.0",
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "node": "22.14.0",
      "autoIncrement": true,
      "channel": "production"
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    "testflight": {
      "extends": "production",
      "environment": "production",
      "env": {
        "APP_VARIANT": "fork",
        "EXPO_OWNER": "oneboyfromife",
        "EXPO_SLUG": "paydrop-mobile",
        "EAS_PROJECT_ID": "3675fd77-9901-4d22-ba8f-2f95f7f32ec4",
        "IOS_BUNDLE_ID": "com.paydrop.paydrop"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6767659511"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6767659511"
      }
    }
  }
}
