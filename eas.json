{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      },
      "channel": "development"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6767659511"
      }
    }
  }
}
