# Public build configuration; never put credentials here.
EXPO_PUBLIC_API_URL=https://pay-drop-backend.vercel.app/api/v1
EXPO_PUBLIC_BLE_ENABLED=true
# Set true only after the backend contracts in docs/ble-transfer-architecture.md pass staging.
EXPO_PUBLIC_TRANSFER_CONTRACT_CONFIRMED=false
EXPO_PUBLIC_TRANSFER_STATUS_PATH=/transactions/:id
# Set the actual backend-agreed key lookup route; leave unset until agreed.
# EXPO_PUBLIC_TRANSFER_KEY_LOOKUP_PATH=/transactions/by-idempotency-key/:key
# Optional JSON WebSocket transport; leave unset if the server uses a different protocol.
# EXPO_PUBLIC_REALTIME_URL=wss://your-staging-host/events
