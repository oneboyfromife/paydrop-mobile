# Public build configuration; never put credentials here.
# API reference: https://paydrop-backend.onrender.com/docs (spec: /docs-json)
EXPO_PUBLIC_API_URL=https://paydrop-backend.onrender.com/api/v1
EXPO_PUBLIC_BLE_ENABLED=true
# Payments stay disabled until ALLOW / FLAG / BLOCK have been exercised end to end with
# funded sandbox accounts (see docs/ble-transfer-architecture.md). Then set true.
EXPO_PUBLIC_TRANSFER_CONTRACT_CONFIRMED=false
EXPO_PUBLIC_TRANSFER_STATUS_PATH=/transactions/:id
# Recovery lookup by the original Idempotency-Key (live on the backend, scoped to the caller).
EXPO_PUBLIC_TRANSFER_KEY_LOOKUP_PATH=/transactions/by-idempotency-key/:key
# Dev/QA only: shows "Test login" on the Login screen (backend AUTH_TEST_MODE, no SMS).
EXPO_PUBLIC_AUTH_TEST_MODE=false
# The backend exposes no WebSocket; leave unset. REST recovery still works.
# EXPO_PUBLIC_REALTIME_URL=
